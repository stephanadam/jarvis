# Copy to .env.local for local Next.js. Never commit real values.
# Bind the same names as Cursor app secrets when publishing.

# Google AI Studio (Jarvis brain)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Home Assistant via Nabu Casa
NABU_CASA_URL=
# HA_URL=
HA_TOKEN=

# Optional: device API key for iPhone clients (header X-Jarvis-Key).
# Required when the publish-app is public so /api is not open to the world.
# Private Cursor apps block the phone before this key is checked — see ios/Jarvis/README.md.
JARVIS_API_KEY=
