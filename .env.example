# Copy to .env.local for local Next.js. Never commit real values.
# Bind the same names as Cursor app secrets when publishing.

# Client auth for /api/chat (and detailed /api/health)
# Bind in Cursor secure form; paste the same value in the web UI Settings
# field and later in Safari Settings for the iPhone app.
JARVIS_API_KEY=

# Google AI Studio (Jarvis brain)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Home Assistant via Nabu Casa
NABU_CASA_URL=
# HA_URL=
HA_TOKEN=
