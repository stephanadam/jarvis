{
  "name": "jarvis",
  "private": true,
  "type": "module",
  "description": "Jarvis home assistant HTTP brain (Gemini + Home Assistant) for Cursor publish-app",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "check": "tsc --noEmit",
    "agent:validate": "npx --yes @grok/agent-sdk@0.7.2 validate --dir .",
    "agent:dev": "npx --yes @grok/agent-sdk@0.7.2 dev",
    "agent:eval": "npx --yes @grok/agent-sdk@0.7.2 eval --dir ."
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
